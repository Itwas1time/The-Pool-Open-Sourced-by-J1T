[Unit]
Description=local project outage watcher and standing Pool relaunch trigger
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/env python3 %h/outage/outage_watch.py run --standing
Restart=on-failure
RestartSec=60
# never take a reborn process down with the watcher
KillMode=process
Nice=10

[Install]
WantedBy=default.target
